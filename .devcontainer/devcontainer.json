{
  "name": "Week 09 Python 3.14",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "forwardPorts": [
    5000
  ],
  "portsAttributes": {
    "5000": {
      "label": "Private Notes teaching lab",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}